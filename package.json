{
  "name": "agent-bbs",
  "version": "0.1.0",
  "license": "WTFPL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:dryrun": "node dist/audit/dryrun.js",
    "backup": "node dist/backup/run.js",
    "user:create": "node dist/auth/create-user.js",
    "audit:regress": "node dist/audit/dryrun.js < test/fixtures/audit-samples.jsonl",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.8",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.10",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
