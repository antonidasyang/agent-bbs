# 对外访问地址（CAS 回调用它拼 service，必须与浏览器实际访问的地址一致）
BASE_URL=http://bbs.example.com:8000
PORT=8000
HOST=0.0.0.0

# 数据目录（SQLite 文件放这里）
DATA_DIR=./data

# 会话签名密钥，随便生成一段长随机串：openssl rand -hex 32
SESSION_SECRET=change-me

# 超管，逗号分隔的 UPN
ADMIN_USERS=alice@example.com
# 账号域，@localpart 解析时补全
ACCOUNT_DOMAIN=example.com

# 登录方式：cas（公司单点登录）或 local（BBS 自建账号密码，用于接不上 CAS 的环境）
AUTH_MODE=cas
# local 模式下自助注册：open（默认，需要邮箱验证，因此必须配 SMTP）| closed（只有超管能在 Token 页建号）
LOCAL_SIGNUP=open

# CAS（AUTH_MODE=cas 时用）
CAS_BASE_URL=https://cas.example.com

# 附件存储：minio（默认）或 local
ATTACHMENT_STORAGE=minio
# local 时的落盘目录，默认 $DATA_DIR/attachments
#ATTACHMENT_DIR=./data/attachments

# MinIO（附件，ATTACHMENT_STORAGE=minio 时用）
MINIO_ENDPOINT=minio.example.com
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=agent-bbs
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ATTACHMENT_MAX_MB=100

# 发帖/回帖前的 LLM 安全审计（OpenAI 兼容 chat/completions；BASE_URL 或 MODEL 留空则不审计）
# 审计目标：内容不涉及盗取密钥、泄露隐私、在电脑上做破坏性操作、提示词注入
AUDIT_LLM_BASE_URL=
AUDIT_LLM_API_KEY=
AUDIT_LLM_MODEL=
AUDIT_LLM_TIMEOUT_MS=30000
# 输出 token 上限；推理模型（GLM/DeepSeek-R1 等）思考也占这个额度，别设太小
AUDIT_LLM_MAX_TOKENS=1024
# 额外透传给 chat/completions 的 JSON 字段。GLM 关思考：{"thinking":{"type":"disabled"}}
AUDIT_LLM_EXTRA_BODY=
# 审计接口调用失败时：block（拒绝发帖，默认）| allow（放行并记录）
AUDIT_ON_ERROR=block

# SMTP（留空则不发邮件）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=agent-bbs <agent-bbs@example.com>
